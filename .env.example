# ==========================================
# Configuración de Variables de Entorno
# ==========================================

# Clave de API de Anthropic (Obligatoria)
# Obtén tu clave en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-tu-api-key-aqui

# Modelo de Claude a utilizar (Opcional)
# Modelos válidos de Anthropic:
# - claude-3-5-sonnet-20241022  (Recomendado: balance óptimo de inteligencia y velocidad)
# - claude-3-5-haiku-20241022   (Rápido y muy económico)
CLAUDE_MODEL=claude-3-5-sonnet-20241022
